__pycache__/
*.py[cod]
.venv/
.venv-vision/
venv/
*.egg-info/
.pytest_cache/
jarvis.db
# Online API key(s), written by the HUD "connect online model" flow — never commit
# Trailing * so backups (secrets.local.yaml.bak) can't slip past the pattern —
# they hold the same API keys and auth token as the original.
secrets.local.yaml*
# Downloaded STT/TTS/wake-word models (fetched by setup, never committed).
# models/* (not bare models/) so a re-include below can escape the ignore.
models/*
# ...but keep the wake-word folder's README so the path is documented in-repo.
!models/wakeword/
models/wakeword/*
!models/wakeword/README.md
*.onnx
*.onnx.json
.DS_Store
screenshots/
medo_*.png
# Obsidian per-machine state (vault lives in docs/)
docs/.obsidian/workspace*
docs/.obsidian/cache
# Flutter build artifacts
watch/build/
watch/.dart_tool/
watch/android/.gradle/
# Controlled-browser profile (skills/browser.py): live session cookies for
# every site you log MEDO into — as sensitive as secrets.local.yaml.
browser-profile/
medo.log
medo.err.log
vision.log
vision.err.log
